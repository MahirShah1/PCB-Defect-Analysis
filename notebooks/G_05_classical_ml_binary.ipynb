   "source": [
    "# Cell 5: 2D PCA scatter --> (PC1 vs PC2, binary labels)\n",
    "\n",
    "plt.figure(figsize=(8, 7))\n",
    "\n",
    "for label_val, label_name, color in [\n",
    "    (0, \"background\", \"tab:blue\"),\n",
    "    (1, \"defect\",      \"tab:orange\"),\n",
    "]:\n",
    "    mask = (y_pca_base == label_val)\n",
    "    plt.scatter(\n",
    "        X_pca[mask, 0],\n",
    "        X_pca[mask, 1],\n",
    "        s=8,\n",
    "        alpha=0.4,\n",
    "        label=label_name,\n",
    "    )\n",
    "\n",
    "plt.title(\"Binary PCA (engineered features): background vs defect\")\n",
    "plt.xlabel(\"PC1\")\n",
    "plt.ylabel(\"PC2\")\n",
    "plt.legend()\n",
    "plt.grid(alpha=0.2)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
