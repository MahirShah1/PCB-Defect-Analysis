   "source": [
    "# Cell 1: Imports, paths, and data loading\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.decomposition import PCA\n",
    "\n",
    "# ---- Paths ----\n",
    "REPO_ROOT = Path.cwd().parents[0] if Path.cwd().name == \"notebooks\" else Path.cwd()\n",
    "FEATURE_ROOT = REPO_ROOT / \"data\" / \"features\"\n",
    "\n",
    "print(\"REPO_ROOT   :\", REPO_ROOT)\n",
    "print(\"FEATURE_ROOT:\", FEATURE_ROOT)\n",
    "\n",
    "# ---- Class names ----\n",
    "CLASSES = [\n",
    "    \"background\",\n",
    "    \"missing_hole\",\n",
    "    \"mouse_bite\",\n",
    "    \"open_circuit\",\n",
    "    \"short\",\n",
    "    \"spur\",\n",
    "    \"spurious_copper\",\n",
    "]\n",
    "\n",
    "feature_file = FEATURE_ROOT / \"pcb_features_raw.npz\"\n",
    "print(\"\\nLoading feature file:\", feature_file)\n",
    "\n",
    "data = np.load(feature_file)\n",
    "\n",
    "X_train_raw = data[\"X_train\"]\n",
    "X_val_raw   = data[\"X_val\"]\n",
    "X_test_raw  = data[\"X_test\"]\n",
    "y_train     = data[\"y_train\"]\n",
    "y_val       = data[\"y_val\"]\n",
    "y_test      = data[\"y_test\"]\n",
    "\n",
    "# double checking for us to ensure data traceability\n",
    "print(\"\\nShapes (multi-class):\")\n",
    "print(\"X_train_raw:\", X_train_raw.shape)\n",
    "print(\"X_val_raw  :\", X_val_raw.shape)\n",
    "print(\"X_test_raw :\", X_test_raw.shape)\n",
    "print(\"y_train    :\", y_train.shape)\n",
    "print(\"y_val      :\", y_val.shape)\n",
    "print(\"y_test     :\", y_test.shape)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c2984f3f-2579-4ad2-b880-62d65f0a9423",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 2: Convert to binary labels --> (background vs defect)\n",
    "\n",
    "def to_binary_labels(y_multiclass):\n",
    "    return (y_multiclass != 0).astype(np.int32)\n",
    "\n",
    "y_train_bin = to_binary_labels(y_train)\n",
    "y_val_bin   = to_binary_labels(y_val)\n",
    "y_test_bin  = to_binary_labels(y_test)\n",
    "\n",
    "BIN_LABELS = {0: \"background\", 1: \"defect\"}\n",
    "\n",
    "# binary label counts print\n",
    "print(\"Binary label counts:\")\n",
    "for split_name, y in [(\"train\", y_train_bin), (\"val\", y_val_bin), (\"test\", y_test_bin)]:\n",
    "    unique, counts = np.unique(y, return_counts=True)\n",
    "    print(f\"\\n{split_name.upper()}:\")\n",
    "    for u, c in zip(unique, counts):\n",
    "        print(f\"  {BIN_LABELS[u]:11s} -> {c}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2accef39-2082-4745-8f68-fd5aa95f2394",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 3: Build a combined feature matrix for PCA\n",
    "\n",
    "# using all the splits here...\n",
    "X_full_raw = np.vstack([X_train_raw, X_val_raw, X_test_raw])\n",
    "y_full_bin = np.concatenate([y_train_bin, y_val_bin, y_test_bin])\n",
    "\n",
    "print(\"Combined raw feature matrix:\", X_full_raw.shape)\n",
    "print(\"Combined binary labels    :\", y_full_bin.shape)\n",
    "\n",
    "# supsample the PCA for strongly associated points\n",
    "MAX_POINTS = 8000   \n",
    "\n",
    "if X_full_raw.shape[0] > MAX_POINTS:\n",
    "    rng = np.random.default_rng(42)\n",
    "    idx = rng.choice(X_full_raw.shape[0], size=MAX_POINTS, replace=False)\n",
    "    X_pca_base = X_full_raw[idx]\n",
    "    y_pca_base = y_full_bin[idx]\n",
    "    print(f\"\\nSubsampled for PCA: {X_pca_base.shape[0]} points\")\n",
    "else:\n",
    "    X_pca_base = X_full_raw\n",
    "    y_pca_base = y_full_bin\n",
    "    print(\"\\nUsing all points for PCA.\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b001f824-f20c-48f8-915b-5e05d1d7acbd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 4: Scale features & run PCA binary version. Rechecking PCA\n",
    "\n",
    "# Standardize features before PCA\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X_pca_base)\n",
    "\n",
    "n_features = X_scaled.shape[1]\n",
    "# cap at 50 PCs...\n",
    "n_components = min(50, n_features)   \n",
    "\n",
    "pca = PCA(n_components=n_components, random_state=42)\n",
    "X_pca = pca.fit_transform(X_scaled)\n",
    "\n",
    "print(f\"engineered_full feature matrix: {X_scaled.shape}\")\n",
    "print(f\"PCA: using n_components={n_components}\")\n",
    "\n",
    "# explained variance info for printing\n",
    "exp_var = pca.explained_variance_ratio_\n",
    "cum_var = np.cumsum(exp_var)\n",
    "\n",
    "print(\"Explained variance (first 5):\", np.round(exp_var[:5], 4))\n",
    "print(\"Cumulative 10:\", np.round(cum_var[:10], 4))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "aef6bc9d-fc7a-4dec-9b01-f20b59c20a65",
