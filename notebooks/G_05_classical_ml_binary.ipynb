    "# Random Forest with RAPIDS (binary) + simple hyperparam search\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.metrics import classification_report, confusion_matrix, f1_score\n",
    "\n",
    "# trying to train on rapids cuda accel\n",
    "print(\"Checking for RAPIDS cuML...\")\n",
    "\n",
    "try:\n",
    "    import cupy as cp\n",
    "    from cuml.ensemble import RandomForestClassifier as cuRF\n",
    "    rapids_available = True\n",
    "    print(\"RAPIDS cuML found – using GPU RandomForest.\")\n",
    "except ImportError:\n",
    "    rapids_available = False\n",
    "    print(\"RAPIDS cuML not available. This cell will fall back to sklearn RF.\")\n",
    "\n",
    "# ---- make sure features are scaled exactly as before ----\n",
    "X_train_scaled = scaler.fit_transform(X_train_raw)\n",
    "X_val_scaled   = scaler.transform(X_val_raw)\n",
    "\n",
    "if rapids_available:\n",
    "    # ---- move data to GPU ----\n",
    "    Xtr_gpu  = cp.asarray(X_train_scaled)\n",
    "    Xval_gpu = cp.asarray(X_val_scaled)\n",
    "    ytr_gpu  = cp.asarray(y_train_bin.astype(np.int32))\n",
    "\n",
    "    # Small hyperparameter grid (keep it modest so it runs fast)\n",
    "    n_estimators_list = [200, 400]\n",
    "    max_depth_list    = [10, 16, None]\n",
    "\n",
    "    best_f1 = -1.0\n",
    "    best_model = None\n",
    "    best_params = None\n",
    "\n",
    "    for n_est in n_estimators_list:\n",
    "        for mdepth in max_depth_list:\n",
    "            print(f\"\\nTraining cuRF (GPU): n_estimators={n_est}, max_depth={mdepth}\")\n",
    "\n",
    "            model = cuRF(\n",
    "                n_estimators=n_est,\n",
    "                max_depth=mdepth,\n",
    "                max_features=\"auto\",\n",
    "                random_state=42,\n",
    "                n_streams=8,   # parallel GPU streams\n",
    "            )\n",
    "\n",
    "            model.fit(Xtr_gpu, ytr_gpu)\n",
    "\n",
    "            # Predict on VAL (GPU → CPU)\n",
    "            y_val_pred_gpu = model.predict(Xval_gpu)\n",
    "            y_val_pred = cp.asnumpy(y_val_pred_gpu)\n",
    "\n",
    "            f1 = f1_score(y_val_bin, y_val_pred)\n",
    "            print(f\"  VAL F1(defect class) = {f1:.4f}\")\n",
    "\n",
    "            if f1 > best_f1:\n",
    "                best_f1 = f1\n",
    "                best_model = model\n",
    "                best_params = (n_est, mdepth)\n",
    "\n",
    "    print(\"\\nBest cuRF params (GPU):\")\n",
    "    print(f\"  n_estimators={best_params[0]}, max_depth={best_params[1]}\")\n",
    "    print(f\"  Best VAL F1(defect) = {best_f1:.4f}\")\n",
    "\n",
    "    # Final report for best GPU model\n",
    "    y_val_best = cp.asnumpy(best_model.predict(Xval_gpu))\n",
    "\n",
    "else:\n",
    "    # ---- Fallback: sklearn RandomForest (CPU) with same grid ----\n",
    "    from sklearn.ensemble import RandomForestClassifier\n",
    "\n",
    "    n_estimators_list = [200, 400]\n",
    "    max_depth_list    = [10, 16, None]\n",
    "\n",
    "    best_f1 = -1.0\n",
    "    best_model = None\n",
    "    best_params = None\n",
    "\n",
    "    for n_est in n_estimators_list:\n",
    "        for mdepth in max_depth_list:\n",
    "            print(f\"\\nTraining sklearn RF (CPU): n_estimators={n_est}, max_depth={mdepth}\")\n",
    "\n",
    "            model = RandomForestClassifier(\n",
    "                n_estimators=n_est,\n",
    "                max_depth=mdepth,\n",
    "                n_jobs=-1,\n",
    "                random_state=42,\n",
    "                class_weight=\"balanced\",\n",
    "            )\n",
    "\n",
    "            model.fit(X_train_scaled, y_train_bin)\n",
    "            y_val_pred = model.predict(X_val_scaled)\n",
    "\n",
    "            f1 = f1_score(y_val_bin, y_val_pred)\n",
    "            print(f\"  VAL F1(defect) = {f1:.4f}\")\n",
    "\n",
    "            if f1 > best_f1:\n",
    "                best_f1 = f1\n",
    "                best_model = model\n",
    "                best_params = (n_est, mdepth)\n",
    "\n",
    "    print(\"\\nBest sklearn RF params (CPU):\")\n",
    "    print(f\"  n_estimators={best_params[0]}, max_depth={best_params[1]}\")\n",
