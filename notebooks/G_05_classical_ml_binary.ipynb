    "# ============================================================\n",
    "# Binary Linear SVM (VAL)\n",
    "# ============================================================\n",
    "from sklearn.svm import LinearSVC\n",
    "from sklearn.pipeline import make_pipeline\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import time\n",
    "\n",
    "# Pipeline: StandardScaler -> LinearSVC\n",
    "svm_lin = make_pipeline(\n",
    "    StandardScaler(),\n",
    "    LinearSVC(\n",
    "        C=1.0,\n",
    "        class_weight=\"balanced\",   # handle background vs defect imbalance\n",
    "        max_iter=5000,\n",
    "        dual=False                 # faster when n_samples > n_features (your case)\n",
    "    )\n",
    ")\n",
    "\n",
    "t0 = time.time()\n",
    "svm_lin.fit(X_train_raw, y_train_bin)\n",
    "train_time = time.time() - t0\n",
    "\n",
    "# Predict on val\n",
    "y_val_pred   = svm_lin.predict(X_val_raw)\n",
    "# decision_function gives a signed distance; use for ROC-AUC\n",
    "y_val_scores = svm_lin.decision_function(X_val_raw)\n",
    "\n",
    "print(\"\\n================ Binary Linear SVM (VAL) ================\")\n",
    "print(f\"Train time: {train_time:.1f} s\")\n",
    "\n",
    "print(\n",
    "    classification_report(\n",
    "        y_val_bin,\n",
    "        y_val_pred,\n",
    "        target_names=[BIN_LABELS[0], BIN_LABELS[1]],\n",
    "        digits=3,\n",
    "    )\n",
    ")\n",
    "\n",
    "# Confusion matrix\n",
    "cm = confusion_matrix(y_val_bin, y_val_pred, labels=[0, 1])\n",
    "cm_df = pd.DataFrame(\n",
    "    cm,\n",
    "    index=[f\"true_{BIN_LABELS[0]}\", f\"true_{BIN_LABELS[1]}\"],\n",
    "    columns=[f\"pred_{BIN_LABELS[0]}\", f\"pred_{BIN_LABELS[1]}\"],\n",
    ")\n",
    "print(\"\\nConfusion matrix (VAL):\")\n",
    "display(cm_df)\n",
    "\n",
    "# Try ROC-AUC (treat class 1 as \"defect\")\n",
    "try:\n",
    "    auc = roc_auc_score(y_val_bin, y_val_scores)\n",
    "    print(f\"\\nVal ROC-AUC: {auc:.3f}\")\n",
    "except Exception as e:\n",
    "    print(\"Could not compute ROC-AUC:\", e)                 "
   ]
  },
