    "# ============================================================\n",
    "# Binary XGBoost Classifier (VAL)\n",
    "# ============================================================\n",
    "import xgboost as xgb\n",
    "from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Convert to DMatrix (XGBoost format)\n",
    "dtrain = xgb.DMatrix(X_train_raw, label=y_train_bin)\n",
    "dval   = xgb.DMatrix(X_val_raw,   label=y_val_bin)\n",
    "\n",
    "# XGBoost parameters for tabular engineered features\n",
    "params = {\n",
    "    \"eta\": 0.1,\n",
    "    \"max_depth\": 8,\n",
    "    \"subsample\": 0.9,\n",
    "    \"colsample_bytree\": 0.7,\n",
    "    \"objective\": \"binary:logistic\",\n",
    "    \"eval_metric\": \"auc\",\n",
    "    \"scale_pos_weight\": (len(y_train_bin) - sum(y_train_bin)) / sum(y_train_bin),\n",
    "}\n",
    "\n",
    "evals = [(dtrain, \"train\"), (dval, \"val\")]\n",
    "\n",
    "bst = xgb.train(params, dtrain, num_boost_round=300, evals=evals, early_stopping_rounds=20)\n",
    "\n",
    "# Predict\n",
    "y_val_proba = bst.predict(dval)\n",
    "y_val_pred  = (y_val_proba > 0.5).astype(int)\n",
    "\n",
    "print(\"\\n================ Binary XGBoost (VAL) ================\")\n",
    "print(classification_report(\n",
    "    y_val_bin,\n",
    "    y_val_pred,\n",
    "    target_names=[BIN_LABELS[0], BIN_LABELS[1]],\n",
    "    digits=3,\n",
    "))\n",
    "\n",
    "cm = confusion_matrix(y_val_bin, y_val_pred, labels=[0, 1])\n",
    "cm_df = pd.DataFrame(\n",
    "    cm,\n",
    "    index=[\"true_background\", \"true_defect\"],\n",
    "    columns=[\"pred_background\", \"pred_defect\"],\n",
    ")\n",
    "display(cm_df)\n",
    "\n",
    "print(\"\\nVal ROC-AUC:\", roc_auc_score(y_val_bin, y_val_proba))\n"
   ]
  },
