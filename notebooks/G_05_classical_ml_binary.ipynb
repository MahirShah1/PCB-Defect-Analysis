    "from xgboost import XGBClassifier\n",
    "from sklearn.model_selection import RandomizedSearchCV\n",
    "from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score\n",
    "from scipy.stats import randint, uniform\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# --- 1) Scale features (same as before) ---\n",
    "X_train_scaled = scaler.fit_transform(X_train_raw)\n",
    "X_val_scaled   = scaler.transform(X_val_raw)\n",
    "\n",
    "# Optional: subsample training data just for hyper-param search\n",
    "# (keeps run-time reasonable)\n",
    "max_tune_samples = 30000\n",
    "if X_train_scaled.shape[0] > max_tune_samples:\n",
    "    rng = np.random.default_rng(42)\n",
    "    idx = rng.choice(X_train_scaled.shape[0], size=max_tune_samples, replace=False)\n",
    "    X_tune = X_train_scaled[idx]\n",
    "    y_tune = y_train_bin[idx]\n",
    "else:\n",
    "    X_tune = X_train_scaled\n",
    "    y_tune = y_train_bin\n",
    "\n",
    "# --- 2) Base XGBoost model ---\n",
    "xgb_base = XGBClassifier(\n",
    "    objective=\"binary:logistic\",\n",
    "    eval_metric=\"logloss\",\n",
    "    tree_method=\"hist\",     # fast on CPU\n",
    "    n_estimators=300,\n",
    "    random_state=42,\n",
    "    n_jobs=-1               # use all cores inside the model\n",
    ")\n",
    "\n",
    "# --- 3) Small hyperparameter search space ---\n",
    "param_dist = {\n",
    "    \"max_depth\":        randint(3, 8),\n",
    "    \"learning_rate\":    uniform(0.03, 0.17),  # 0.03–0.20\n",
    "    \"subsample\":        uniform(0.6, 0.4),    # 0.6–1.0\n",
    "    \"colsample_bytree\": uniform(0.6, 0.4),    # 0.6–1.0\n",
    "    \"min_child_weight\": randint(1, 6),\n",
    "    \"gamma\":            uniform(0.0, 2.0),\n",
    "}\n",
    "\n",
    "search = RandomizedSearchCV(\n",
    "    estimator=xgb_base,\n",
    "    param_distributions=param_dist,\n",
    "    n_iter=15,            # keep small so it finishes\n",
    "    scoring=\"f1\",\n",
    "    cv=3,\n",
    "    verbose=2,\n",
    "    n_jobs=1,           
    "    random_state=42\n",
    ")\n",
    "\n",
    "print(\"Starting XGBoost hyperparameter search...\")\n",
    "search.fit(X_tune, y_tune)\n",
    "\n",
    "print(\"\\nBest params:\", search.best_params_)\n",
    "print(\"Best CV F1:\", search.best_score_)\n",
    "\n",
    "best_xgb = search.best_estimator_\n",
    "\n",
    "# --- 4) Evaluate on full validation set ---\n",
    "y_val_pred = best_xgb.predict(X_val_scaled)\n",
    "y_val_proba = best_xgb.predict_proba(X_val_scaled)[:, 1]\n",
    "\n",
    "print(\"\\n================ Binary XGBoost (VAL, tuned) ================\")\n",
    "print(classification_report(\n",
    "    y_val_bin, y_val_pred,\n",
    "    target_names=[BIN_LABELS[0], BIN_LABELS[1]],\n",
    "    digits=3\n",
    "))\n",
    "\n",
    "cm = confusion_matrix(y_val_bin, y_val_pred, labels=[0, 1])\n",
    "cm_df = pd.DataFrame(\n",
    "    cm,\n",
    "    index=[f\"true_{BIN_LABELS[0]}\", f\"true_{BIN_LABELS[1]}\"],\n",
    "    columns=[f\"pred_{BIN_LABELS[0]}\", f\"pred_{BIN_LABELS[1]}\"],\n",
    ")\n",
    "print(\"\\nConfusion matrix (VAL):\")\n",
    "display(cm_df)\n",
    "\n",
    "val_auc = roc_auc_score(y_val_bin, y_val_proba)\n",
    "print(\"\\nVal ROC-AUC:\", val_auc)\n"
