    "\n",
    "    y_val_best = best_model.predict(X_val_scaled)\n",
    "\n",
    "# ---- Common reporting for whichever model won ----\n",
    "print(\"\\n================ Binary RF (best model, VAL) ================\")\n",
    "print(classification_report(\n",
